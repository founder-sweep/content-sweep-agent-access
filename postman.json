{
  "info": {
    "name": "Content Sweep Agent API",
    "description": "Generated from OpenAPI. Begin with sandbox enrollment. Set body fields from the guide. Preserve each idempotency key across retries; clear it only for a genuinely new operation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://contentsweep.ai/api/v1"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "capabilities",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/capabilities",
        "description": "Public capabilities and activation state",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": []
    },
    {
      "name": "auth_metadata",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/auth-metadata",
