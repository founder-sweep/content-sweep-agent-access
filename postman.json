    {
      "name": "enroll",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/enroll",
        "description": "Enroll a sandbox organization",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman sandbox\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.environment.set('token', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
